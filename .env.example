# ==========================================
# Coding Activity Heatmap Environment Configuration
# ==========================================

# 1. GitHub Integration (Official GraphQL API)
# Create a GitHub Classic Personal Access Token with ONLY `read:user` scope:
# Settings -> Developer Settings -> Personal access tokens -> Tokens (classic)
GITHUB_TOKEN=your_github_classic_token_here

# Your GitHub username (used to identify or verify viewer)
GITHUB_USERNAME=lakshay-tiwari

# 2. LeetCode Integration (Alfa LeetCode API)
# Base URL for the Alfa LeetCode API (local Docker instance or deployed instance)
# Example: http://localhost:3000 (do not add trailing slash)
LEETCODE_API_BASE_URL=http://localhost:3000

# Your LeetCode username
LEETCODE_USERNAME=lakshya_tiwari

